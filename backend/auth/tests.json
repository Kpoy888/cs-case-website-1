{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Сессия без токена",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Регистрация без данных",
      "method": "POST",
      "path": "/?action=register",
      "body": { "email": "bad", "nickname": "a", "password": "123" },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Вход с пустыми данными",
      "method": "POST",
      "path": "/?action=login",
      "body": { "email": "", "password": "" },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    }
  ]
}
