{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Инвентарь без входа",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Вывод без входа",
      "method": "POST",
      "path": "/?action=withdraw",
      "body": { "ids": [1], "trade_url": "https://steamcommunity.com/tradeoffer/new/?partner=1&token=abcdef" },
      "expectedStatus": 401,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    }
  ]
}
